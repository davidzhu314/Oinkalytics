# Copy to bot/.env (gitignored) or just export these. Never commit real values.

# --- Photon Spectrum Cloud (dashboard > Settings) ------------------------
# Required by `npm start`. Without them, use `npm run dev`.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Only needed if you serve webhooks instead of the streaming connection.
SPECTRUM_WEBHOOK_SECRET=

# --- Oinkalytics API ----------------------------------------------------
# A teammate's machine on the same Wi-Fi: http://<their-ip>:8000
OINK_API=http://localhost:8000
ALERT_POLL_MS=2000

# --- Demo wiring --------------------------------------------------------
# Phones that get alerts even before they text the bot. Comma-separated.
ALERT_TO=
# Fetch and log alerts but never send them. Use while developing.
BOT_MUTE=false
# Bring up Spectrum's terminal TUI alongside iMessage. Off by default: it
# spawns a downloaded binary that some machines block.
BOT_TERMINAL=false
SUBSCRIBERS_FILE=.subscribers.json

# This file is read automatically when copied to bot/.env (no dotenv needed).
# Point somewhere else with BOT_ENV_FILE=path/to/file.
