# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Photon bot (bot/). BOT_CHANNEL=terminal needs nothing else.
BOT_CHANNEL=terminal
OINK_API=http://localhost:8000
# E.164 phone that gets alerts. Use the dev phone while developing.
FARMER_PHONE=
# Comma-separated senders the bot answers; empty = anyone who reaches the line.
ALLOWED_SENDERS=
# 1 = don't send proactive alerts (they're logged instead). Commands still work.
BOT_MUTE=1
# Spectrum Cloud (BOT_CHANNEL=imessage), from the Photon dashboard project settings.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Barn trends (api/trends.py). Defaults are for a real barn; for the demo, run "days" as 20 s periods:
# TREND_RECENT_S=15
# TREND_BASELINE_S=600
# TREND_MIN_CALLS=6
# TREND_PERIOD_S=20
# TREND_PERIOD_MIN_CALLS=8
